{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_DIR__/hooks/git-guard.mjs\""
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
